  "diagnostic_rules": [
    {
      "diagnosis_id": "MISSING_REPEAT",
      "priority": 10,
      "condition": "program_has_no_repeat"
    },
    {
      "diagnosis_id": "EMPTY_LOOP_BODY",
      "priority": 20,
      "condition": "repeat_body_empty"
    },
    {
      "diagnosis_id": "WRONG_ACTION",
      "priority": 30,
      "condition": "action_not_bound_to_skin"
    },
    {
      "diagnosis_id": "COUNT_TOO_SMALL",
      "priority": 40,
      "condition": "completed_targets_below_target"
    },
    {
      "diagnosis_id": "COUNT_TOO_LARGE",
      "priority": 50,
      "condition": "action_without_target"
    },
    {
      "diagnosis_id": "SUCCESS",
      "priority": 100,
      "condition": "goal_met_with_expected_structure"
    }
  ],
  "stages": [
    {
      "id": "observe",
      "purpose": "只展示 5 颗休眠光种，不提前命名概念"
    },
    {
      "id": "predict",
      "purpose": "预测一次生长会改变多少颗光种"
    },
    {
      "id": "single_action",
      "purpose": "运行一次 grow，让世界验证一次动作只影响一个目标"
    },
    {
      "id": "program",
      "purpose": "从自然语言目标进入积木结构，拖入动作并设置次数"
    },
    {
      "id": "trace",
      "purpose": "逐行高亮程序并与光种、连接线同步反馈"
    },
    {
      "id": "counterfactual",
      "purpose": "把 5 改成 4，明确留下最后一颗未点亮光种"
    },
    {
      "id": "combat",
      "purpose": "把循环装置修复获得的工具用于清除错误怪，完成必经战斗验证"
    },
    {
      "id": "transfer",
      "purpose": "在 6 目标巡检器的新情境中无术语提示迁移"
    },
    {
      "id": "concept_name",
      "purpose": "最后命名循环，并显形 C 语言 for 代码"
    },
    {
      "id": "debug_boss",
      "purpose": "观察护盾与弱点轨迹，修改攻击条件后真实重跑"
    },
    {
      "id": "boss_combat",
      "purpose": "Debug 解除护盾后，由玩家移动、躲避和射击完成战斗收束"
    },
    {
      "id": "explain",
      "purpose": "用学习证据复盘预测、修改、迁移与 Debug"
    }
  ],
  "code_reveal_layers": [
    "world_behavior",
    "natural_language_instruction",
    "block_flow_structure",
    "c_language_code"
  ],
  "hint_policy": [
    {
      "level": 1,
      "intent": "鼓励求助并确认当前世界目标",
      "template": "你愿意求助很好。先确认目标：你希望所有光种最后都醒来，对吗？",
      "reveal_answer": false,
      "next_action": "确认当前目标"
    },
    {
      "level": 2,
      "intent": "引导学生观察执行结果与世界目标之间的偏差",
      "template": "观察运行结果：哪一颗没有按预期变化？比较亮起数量和目标数量。",
      "reveal_answer": false,
      "next_action": "观察未变化的目标"
    },
    {
      "level": 3,
      "intent": "根据确定性诊断缩小到可能出错的程序区域",
      "template": "“生长”动作已经有效，可能出错的是橙色重复结构里的执行次数。",
      "reveal_answer": false,
      "next_action": "检查执行次数"
    },
    {
      "level": 4,
      "intent": "提供部分结构和真实执行轨迹，保留最后推断",
      "template": "看执行轨迹：每执行一次只亮一颗。补齐最后一颗需要的那一步。",
      "reveal_answer": false,
      "next_action": "沿轨迹补齐一步"
    },
    {
      "level": 5,
      "intent": "给出兜底答案并标记复练，仍保留学生执行权",
      "template": "完整结构是“重复5次：生长”。这次会标记复练，仍由你亲手修改并运行。",
      "reveal_answer": true,
      "needs_review": true,
      "next_action": "学生亲手修改并运行"
    }
  ],
  "surprise": {
