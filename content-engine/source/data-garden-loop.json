{
  "unit_id": "UNIT-DATA-GARDEN-LOOP",
  "version": "0.8.1",
  "status": "candidate",
  "audience": {
    "age_band": "8-12",
    "lesson_minutes": 45
  },
  "knowledge": {
    "concept_id": "CONCEPT-LOOP-COUNT",
    "name": "计数循环",
    "cognitive_essence": "先从世界中感知一次动作与一个目标的对应关系，再用重复结构表达规律，通过反事实与陌生迁移形成可解释的循环概念。",
    "mastery": [
      "能预测一次生长只影响一颗光种",
      "能编排重复结构并逐步解释执行轨迹",
      "能通过把 5 改成 4 验证次数对世界结果的影响",
      "能在陌生巡检器中无提示迁移同一结构",
      "能把世界直觉对应到积木结构与 C 语言 for 代码",
      "能根据真实执行轨迹修复 Boss 攻击条件"
    ]
  },
  "misconceptions": [
    {
      "id": "MIS-LOOP-UNDER",
      "signal": "repeat_count < target_count",
      "meaning": "未建立目标数量与执行次数的一一对应",
      "intervention": "保留已完成结果，突出未执行目标并引导观察世界偏差"
    },
    {
      "id": "MIS-LOOP-OVER",
      "signal": "repeat_count > target_count",
      "meaning": "未理解目标耗尽后的边界",
      "intervention": "让多出的执行产生可理解、无惩罚的溢出反馈"
    },
    {
      "id": "MIS-LOOP-ACTION",
      "signal": "action_not_nested",
      "meaning": "尚未把一次动作放进重复结构",
      "intervention": "先运行一次动作，再让学生把动作拖进结构"
    },
    {
      "id": "MIS-BOSS-CONDITION",
      "signal": "attack_when_shielded",
      "meaning": "忽略状态条件，在护盾阶段仍执行攻击",
      "intervention": "回放四拍轨迹并指向条件块，不提供选择题答案"
    }
  ],
